local function getBombTimeText(carrier)
	if not carrier or not carrier.Character then return "" end
	local bomb = hasAnyBomb(carrier.Character) or (carrier:FindFirstChild("Backpack") and hasAnyBomb(carrier.Backpack))
	if not bomb then return "" end
	local timerVal = bomb:FindFirstChild("Timer") or bomb:FindFirstChild("Time") or bomb:FindFirstChild("Fuse")
	if timerVal and timerVal:IsA("ValueBase") then
		return string.format("%.1f초", tonumber(timerVal.Value) or 0)
	end
	local attrTime = bomb:GetAttribute("Time") or bomb:GetAttribute("Timer")
	if attrTime then
		return string.format("%.1f초", tonumber(attrTime) or 0)
	end
	return "폭탄 보류 중"
end

local function createOrUpdateESP(player)
	if player == LocalPlayer or not player.Character or isInvisiblePart(player.Character) then return end
	local char = player.Character
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local head = char:FindFirstChild("Head")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not head or not hum or hum.Health <= 0 then
		if char:FindFirstChild("CustomESP_Gui") then char.CustomESP_Gui:Destroy() end
		if char:FindFirstChild("CustomESP_Highlight") then char.CustomESP_Highlight:Destroy() end
		return
	end

	local carrier = getBombCarrier()
	local isCarrier = (player == carrier)
	local isLocked = (player == lockedTarget)

	local gui = char:FindFirstChild("CustomESP_Gui")
	if Toggles.EnableESP.Value or (Toggles.BombCarrierHighlight.Value and isCarrier) or isLocked then
		if not gui then
			gui = Instance.new("BillboardGui")
			gui.Name = "CustomESP_Gui"
			gui.Adornee = head
			gui.Size = UDim2.new(0, 200, 0, 50)
			gui.StudsOffset = Vector3.new(0, 2.5, 0)
			gui.AlwaysOnTop = true

			local nameLabel = Instance.new("TextLabel")
			nameLabel.Name = "NameLabel"
			nameLabel.Size = UDim2.new(1, 0, 0, 20)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Font = Enum.Font.GothamBold
			nameLabel.TextSize = 14
			nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			nameLabel.TextStrokeTransparency = 0.2
			nameLabel.Parent = gui

			local infoLabel = Instance.new("TextLabel")
			infoLabel.Name = "InfoLabel"
			infoLabel.Size = UDim2.new(1, 0, 0, 18)
			infoLabel.Position = UDim2.new(0, 0, 0, 20)
			infoLabel.BackgroundTransparency = 1
			infoLabel.Font = Enum.Font.Gotham
			infoLabel.TextSize = 12
			infoLabel.Parent = gui

			gui.Parent = char
		end

		local distance = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude) or 0)
		local nameLabel = gui:FindFirstChild("NameLabel")
		local infoLabel = gui:FindFirstChild("InfoLabel")

		if isLocked then
			nameLabel.Text = "타겟" .. player.DisplayName
			nameLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
			infoLabel.Text = "거리: " .. distance .. "m | 추적 중"
			infoLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
		elseif isCarrier then
			local bombText = getBombTimeText(carrier)
			nameLabel.Text = "🥺" .. player.DisplayName .. " (@" .. player.Name .. ")"
			nameLabel.TextColor3 = Options.BombColor.Value
			infoLabel.Text = "[ 폭탄 들고잇는사람 ] - " .. bombText .. " | " .. distance .. "m"
			infoLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		else
			nameLabel.Text = player.DisplayName
			nameLabel.TextColor3 = Options.ESPColor.Value
			infoLabel.Text = distance .. "m | 체력: " .. math.floor(hum.Health)
			infoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
		end
	else
		if gui then gui:Destroy() end
	end

	local highlight = char:FindFirstChild("CustomESP_Highlight")
	local shouldHighlight = Toggles.EnableHighlight.Value or (Toggles.BombCarrierHighlight.Value and isCarrier) or isLocked

	if shouldHighlight then
		if not highlight then
			highlight = Instance.new("Highlight")
			highlight.Name = "CustomESP_Highlight"
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.FillTransparency = 0.5
			highlight.OutlineTransparency = 0
			highlight.Parent = char
		end

		if isLocked then
			highlight.FillColor = Color3.fromRGB(255, 150, 0)
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		elseif isCarrier then
			highlight.FillColor = Options.BombColor.Value
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		else
			highlight.FillColor = Options.ESPColor.Value
			highlight.OutlineColor = Options.ESPColor.Value
		end
	else
		if highlight then highlight:Destroy() end
	end
end

