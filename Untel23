local cachedBaseplate = nil
local playerDataStore = {}

local function getBaseplateInfo()
	if cachedBaseplate then return cachedBaseplate end
	local platform = Workspace:FindFirstChild("Platform")
	if platform then
		local baseplate = platform:FindFirstChild("Baseplate")
		if baseplate and baseplate:IsA("BasePart") then
			local pos, size = baseplate.Position, baseplate.Size
			cachedBaseplate = {
				Part = baseplate, Center = pos, Size = size,
				MinX = pos.X - (size.X / 2), MaxX = pos.X + (size.X / 2),
				MinZ = pos.Z - (size.Z / 2), MaxZ = pos.Z + (size.Z / 2),
				MinY = pos.Y + (size.Y / 2),
			}
			return cachedBaseplate
		end
	end
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate and baseplate:IsA("BasePart") then
		local pos, size = baseplate.Position, baseplate.Size
		cachedBaseplate = {
			Part = baseplate, Center = pos, Size = size,
			MinX = pos.X - (size.X / 2), MaxX = pos.X + (size.X / 2),
			MinZ = pos.Z - (size.Z / 2), MaxZ = pos.Z + (size.Z / 2),
			MinY = pos.Y + (size.Y / 2),
		}
		return cachedBaseplate
	end
	return nil
end

local function isPositionOnBaseplate(targetPos, baseplateInfo)
	if not baseplateInfo then return true end
	return targetPos.X >= baseplateInfo.MinX and targetPos.X <= baseplateInfo.MaxX
		and targetPos.Z >= baseplateInfo.MinZ and targetPos.Z <= baseplateInfo.MaxZ
		and targetPos.Y >= (baseplateInfo.MinY - 15)
end

local function clampPositionToCenter(targetPos, baseplateInfo)
	local safeY = targetPos.Y
	if baseplateInfo then
		safeY = math.max(targetPos.Y, baseplateInfo.MinY + 3.0)
		local limitX = baseplateInfo.Size.X * 0.4
		local limitZ = baseplateInfo.Size.Z * 0.4
		local clampedX = math.clamp(targetPos.X, baseplateInfo.Center.X - limitX, baseplateInfo.Center.X + limitX)
		local clampedZ = math.clamp(targetPos.Z, baseplateInfo.Center.Z - limitZ, baseplateInfo.Center.Z + limitZ)
		return Vector3.new(clampedX, safeY, clampedZ)
	end
	return Vector3.new(targetPos.X, safeY, targetPos.Z)
end

local function analyzePlayerMovement(dt)
	local safeDt = math.max(dt, 0.001)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = player.Character.HumanoidRootPart
			local userId = player.UserId
			if not playerDataStore[userId] then
				playerDataStore[userId] = { lastPos = hrp.Position, velocity = Vector3.new(0, 0, 0), speed = 0 }
			end
			local data = playerDataStore[userId]
			local currentPos = hrp.Position
			local currentVelocity = (currentPos - data.lastPos) / safeDt
			data.velocity = data.velocity:Lerp(currentVelocity, 0.7)
			data.speed = data.velocity.Magnitude
			data.lastPos = currentPos
		end
	end
end

local function hasAnyBomb(parent)
	if not parent then return nil end
	for _, bombName in ipairs(BombList) do
		local found = parent:FindFirstChild(bombName)
		if found then return found end
	end
	return nil
end

local function isInvisiblePart(item)
	local current = item
	while current and current ~= Workspace do
		if current.Name == "Invis" then return true end
		current = current.Parent
	end
	return false
end

local function getBombCarrier()
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char and not isInvisiblePart(char) then
			local inChar = hasAnyBomb(char)
			local inBackpack = player:FindFirstChild("Backpack") and hasAnyBomb(player.Backpack)
			if inChar or inBackpack then return player end
		end
	end
	return nil
end

local lockedTarget = nil

local function getOptimalNearestTarget(baseplateInfo)
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil, math.huge end
	local myPos = myChar.HumanoidRootPart.Position

	if lockedTarget and lockedTarget.Parent and lockedTarget.Character and lockedTarget.Character:FindFirstChild("HumanoidRootPart") and lockedTarget.Character:FindFirstChildOfClass("Humanoid") then
		local lHum = lockedTarget.Character:FindFirstChildOfClass("Humanoid")
		local lHrp = lockedTarget.Character.HumanoidRootPart
		if lHum.Health > 0 and isPositionOnBaseplate(lHrp.Position, baseplateInfo) then
			local dist = (lHrp.Position - myPos).Magnitude
			if dist < 180 then 
				return lockedTarget, dist
			end
		end
	end

	local closest, minDist = nil, math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			if char and not isInvisiblePart(char) and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local targetHrp = char.HumanoidRootPart
				
				if hum.Health > 0 and isPositionOnBaseplate(targetHrp.Position, baseplateInfo) then
					local dist = (targetHrp.Position - myPos).Magnitude
					if dist < minDist then
						minDist = dist
						closest = player
					end
				end
			end
		end
	end

	lockedTarget = closest
	return closest, minDist
end

local lastStuckCheckPos = Vector3.new(0, 0, 0)
local stuckTimer = 0
local alternateOffsetAngle = 0

local function getSmartEscapePosition(targetDesiredPos, myHrpPos, baseplateInfo, dt)
	local distanceMoved = (myHrpPos - lastStuckCheckPos).Magnitude
	
	if distanceMoved < 0.6 then
		stuckTimer = stuckTimer + dt
	else
		stuckTimer = 0
		lastStuckCheckPos = myHrpPos
	end

	local finalPos = targetDesiredPos

	if stuckTimer >= 1.5 then
		alternateOffsetAngle = (alternateOffsetAngle == 90) and -90 or 90
		local currentDir = (targetDesiredPos - myHrpPos)
		if currentDir.Magnitude > 0 then
			currentDir = currentDir.Unit
		else
			currentDir = Vector3.new(1, 0, 0)
		end
		
		local rotCFrame = CFrame.Angles(0, math.rad(alternateOffsetAngle + math.random(-30, 30)), 0)
		local newDir = rotCFrame * currentDir
		finalPos = myHrpPos + (newDir * 40)
		
		stuckTimer = 0
		lastStuckCheckPos = myHrpPos
	end

	return clampPositionToCenter(finalPos, baseplateInfo)
end

RunService.Heartbeat:Connect(function(dt)
	local autoPass = Toggles.AutoPass and Toggles.AutoPass.Value
	local autoFlee = Toggles.AutoFlee and Toggles.AutoFlee.Value

	if not autoPass and not autoFlee then 
		lockedTarget = nil
		stuckTimer = 0
		return 
	end

	local myChar = LocalPlayer.Character
	if not myChar then return end
	local myHrp = myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar:FindFirstChildOfClass("Humanoid")
	if not myHrp or not myHum or myHum.Health <= 0 then return end

	local baseplateInfo = getBaseplateInfo()
	if not isPositionOnBaseplate(myHrp.Position, baseplateInfo) then return end

	analyzePlayerMovement(dt)

	local hasBombInChar = hasAnyBomb(myChar) ~= nil
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	local hasBombInBackpack = backpack and hasAnyBomb(backpack) ~= nil
	local hasBomb = hasBombInChar or hasBombInBackpack

	local carrier = getBombCarrier()

	if hasBomb then
		myHum.WalkSpeed = Options.BombPassSpeed and Options.BombPassSpeed.Value or 17

		if autoPass then
			local target, minDist = getOptimalNearestTarget(baseplateInfo)
			if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
				local targetHrp = target.Character.HumanoidRootPart
				local targetData = playerDataStore[target.UserId]
				
				local leadTime = math.clamp(minDist / 50, 0.05, 0.4)
				local predictedPos = targetHrp.Position
				if targetData and targetData.speed > 0.5 then
					predictedPos = targetHrp.Position + (Vector3.new(targetData.velocity.X, 0, targetData.velocity.Z) * leadTime)
				end

				local smartTargetPos = getSmartEscapePosition(predictedPos, myHrp.Position, baseplateInfo, dt)
				myHum:MoveTo(smartTargetPos)

				if firetouchinterest then
					firetouchinterest(myHrp, targetHrp, 0)
					firetouchinterest(myHrp, targetHrp, 1)
				end

				local currentPassRemote = game:GetService("ReplicatedStorage"):FindFirstChild("PassBomb")
				if currentPassRemote and minDist < 40 then
					currentPassRemote:FireServer(target)
				end
			end
		end
	else
		lockedTarget = nil
		myHum.WalkSpeed = 16

		if autoFlee and carrier and carrier ~= LocalPlayer and carrier.Character then
			local carrierHrp = carrier.Character:FindFirstChild("HumanoidRootPart")
			if carrierHrp and not isInvisiblePart(carrier.Character) then
				local diff = myHrp.Position - carrierHrp.Position
				local fleeDir = Vector3.new(diff.X, 0, diff.Z)
				if fleeDir.Magnitude < 1 then
					fleeDir = Vector3.new(math.random(-1, 1), 0, math.random(-1, 1))
				end
				fleeDir = fleeDir.Unit

				local escapeTarget = myHrp.Position + (fleeDir * 45)
				
				local smartEscapePos = getSmartEscapePosition(escapeTarget, myHrp.Position, baseplateInfo, dt)
				myHum:MoveTo(smartEscapePos)
			end
		else
			stuckTimer = 0
			local idleWander = myHrp.Position + Vector3.new(math.sin(tick() * 2) * 15, 0, math.cos(tick() * 2) * 15)
			local safeIdlePos = clampPositionToCenter(idleWander, baseplateInfo)
			myHum:MoveTo(safeIdlePos)
		end
	end
end)

