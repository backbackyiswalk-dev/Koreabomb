local cachedBaseplate = nil
local playerDataStore = {}

local function getBaseplateInfo()
	if cachedBaseplate then return cachedBaseplate end
	local platform = Workspace:FindFirstChild("Platform")
	if platform then
		local baseplate = platform:FindFirstChild("Baseplate")
		if baseplate and baseplate:IsA("BasePart") then
			local pos, size = baseplate.Position, baseplate.Size
			cachedBaseplate = {
				Part = baseplate, Center = pos, Size = size,
				MinX = pos.X - (size.X / 2), MaxX = pos.X + (size.X / 2),
				MinZ = pos.Z - (size.Z / 2), MaxZ = pos.Z + (size.Z / 2),
				MinY = pos.Y + (size.Y / 2),
			}
			return cachedBaseplate
		end
	end
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate and baseplate:IsA("BasePart") then
		local pos, size = baseplate.Position, baseplate.Size
		cachedBaseplate = {
			Part = baseplate, Center = pos, Size = size,
			MinX = pos.X - (size.X / 2), MaxX = pos.X + (size.X / 2),
			MinZ = pos.Z - (size.Z / 2), MaxZ = pos.Z + (size.Z / 2),
			MinY = pos.Y + (size.Y / 2),
		}
		return cachedBaseplate
	end
	return nil
end

local function isPositionOnBaseplate(targetPos, baseplateInfo)
	if not baseplateInfo then return true end
	return targetPos.X >= baseplateInfo.MinX and targetPos.X <= baseplateInfo.MaxX
		and targetPos.Z >= baseplateInfo.MinZ and targetPos.Z <= baseplateInfo.MaxZ
		and targetPos.Y >= (baseplateInfo.MinY - 15)
end

local function clampPositionToCenter(targetPos, baseplateInfo)
	local safeY = targetPos.Y
	if baseplateInfo then
		safeY = math.max(targetPos.Y, baseplateInfo.MinY + 3.0)
		local limitX = baseplateInfo.Size.X * 0.4
		local limitZ = baseplateInfo.Size.Z * 0.4
		local clampedX = math.clamp(targetPos.X, baseplateInfo.Center.X - limitX, baseplateInfo.Center.X + limitX)
		local clampedZ = math.clamp(targetPos.Z, baseplateInfo.Center.Z - limitZ, baseplateInfo.Center.Z + limitZ)
		return Vector3.new(clampedX, safeY, clampedZ)
	end
	return Vector3.new(targetPos.X, safeY, targetPos.Z)
end

local function analyzePlayerMovement(dt)
	local safeDt = math.max(dt, 0.001)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = player.Character.HumanoidRootPart
			local userId = player.UserId
			if not playerDataStore[userId] then
				playerDataStore[userId] = { lastPos = hrp.Position, velocity = Vector3.new(0, 0, 0), speed = 0 }
			end
			local data = playerDataStore[userId]
			local currentPos = hrp.Position
			local currentVelocity = (currentPos - data.lastPos) / safeDt
			data.velocity = data.velocity:Lerp(currentVelocity, 0.6)
			data.speed = data.velocity.Magnitude
			data.lastPos = currentPos
		end
	end
end

local function hasAnyBomb(parent)
	if not parent then return nil end
	for _, bombName in ipairs(BombList) do
		local found = parent:FindFirstChild(bombName)
		if found then return found end
	end
	return nil
end

local function isInvisiblePart(item)
	local current = item
	while current and current ~= Workspace do
		if current.Name == "Invis" then return true end
		current = current.Parent
	end
	return false
end

local function getBombCarrier()
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char and not isInvisiblePart(char) then
			local inChar = hasAnyBomb(char)
			local inBackpack = player:FindFirstChild("Backpack") and hasAnyBomb(player.Backpack)
			if inChar or inBackpack then return player end
		end
	end
	return nil
end

local lockedTarget = nil

local function getOptimalNearestTarget(baseplateInfo)
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil, math.huge end
	local myPos = myChar.HumanoidRootPart.Position

	if lockedTarget and lockedTarget.Parent and lockedTarget.Character and lockedTarget.Character:FindFirstChild("HumanoidRootPart") and lockedTarget.Character:FindFirstChildOfClass("Humanoid") then
		local lHum = lockedTarget.Character:FindFirstChildOfClass("Humanoid")
		local lHrp = lockedTarget.Character.HumanoidRootPart
		if lHum.Health > 0 and isPositionOnBaseplate(lHrp.Position, baseplateInfo) then
			local dist = (lHrp.Position - myPos).Magnitude
			if dist < 180 then 
				return lockedTarget, dist
			end
		end
	end

	local closest, minDist = nil, math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			if char and not isInvisiblePart(char) and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local targetHrp = char.HumanoidRootPart
				
				if hum.Health > 0 and isPositionOnBaseplate(targetHrp.Position, baseplateInfo) then
					local dist = (targetHrp.Position - myPos).Magnitude
					if dist < minDist then
						minDist = dist
						closest = player
					end
				end
			end
		end
	end

	lockedTarget = closest
	return closest, minDist
end

local path = PathfindingService:CreatePath({
	AgentRadius = 2,
	AgentHeight = 5,
	AgentCanJump = true,
	WaypointSpacing = 3,
	Costs = { Ladder = 0.1 }
})

local currentWaypoints = {}
local currentWaypointIndex = 1
local lastPathComputeTick = 0
local wanderTargetOffset = Vector3.new(0, 0, 0)
local lastWanderChangeTick = 0

local function getHumanLikeTargetPosition(targetHrp, targetData, baseplateInfo, isFleeing)
	local now = tick()
	local speed = targetData and targetData.speed or 0

	if isFleeing then
		local diff = LocalPlayer.Character.HumanoidRootPart.Position - targetHrp.Position
		local baseDir = Vector3.new(diff.X, 0, diff.Z)
		if baseDir.Magnitude < 1 then baseDir = Vector3.new(math.random(-1, 1), 0, math.random(-1, 1)) end
		baseDir = baseDir.Unit
		
		local randomOffset = Vector3.new(math.sin(now * 3) * 6, 0, math.cos(now * 2) * 6)
		return targetHrp.Position + (baseDir * 65) + randomOffset
	else
		if speed < 1.5 then
			if now - lastWanderChangeTick > 2.2 then
				local angle = math.random() * math.pi * 2
				local radius = math.random(3, 8)
				wanderTargetOffset = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
				lastWanderChangeTick = now
			end
			return targetHrp.Position + wanderTargetOffset
		else
			lastWanderChangeTick = 0
			local leadTime = 0.3
			return targetHrp.Position + (Vector3.new(targetData.velocity.X, 0, targetData.velocity.Z) * leadTime)
		end
	end
end

local function moveToContinuousSmartDestination(myHrp, myHum, targetPos, baseplateInfo)
	local now = tick()
	local clampedTarget = clampPositionToCenter(targetPos, baseplateInfo)

	if #currentWaypoints == 0 or currentWaypointIndex > #currentWaypoints or (now - lastPathComputeTick > 0.35) then
		local success = pcall(function()
			path:ComputeAsync(myHrp.Position, clampedTarget)
		end)

		if success and path.Status == Enum.PathStatus.Success then
			local newWaypoints = path:GetWaypoints()
			if #newWaypoints > 0 then
				currentWaypoints = newWaypoints
				currentWaypointIndex = 2 
				if currentWaypointIndex > #currentWaypoints then
					currentWaypointIndex = #currentWaypoints
				end
				lastPathComputeTick = now
			end
		else
			myHum:MoveTo(clampedTarget)
			return
		end
	end

	if currentWaypointIndex <= #currentWaypoints then
		local waypoint = currentWaypoints[currentWaypointIndex]
		myHum:MoveTo(waypoint.Position)

		if waypoint.Action == Enum.PathWaypointAction.Custom and waypoint.Label == "Ladder" then
			myHum.Jump = true
		elseif waypoint.Action == Enum.PathWaypointAction.Jump or waypoint.Position.Y > (myHrp.Position.Y + 2.3) then
			myHum.Jump = true
		end

		if (myHrp.Position - waypoint.Position).Magnitude < 4.0 then
			currentWaypointIndex = currentWaypointIndex + 1
		end
	else
		myHum:MoveTo(clampedTarget)
	end
end

local activeTween = nil
local function moveToTweenDestination(myHrp, targetPos, baseplateInfo)
	local clampedTarget = clampPositionToCenter(targetPos, baseplateInfo)
	if activeTween then
		activeTween:Cancel()
	end
	local distance = (myHrp.Position - clampedTarget).Magnitude
	local speed = 80
	local duration = math.clamp(distance / speed, 0.05, 0.4)
	
	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	activeTween = TweenService:Create(myHrp, tweenInfo, { CFrame = CFrame.new(clampedTarget) })
	activeTween:Play()
end

