local function createParticle(parent, texture, color, size, lifetime, speed, rate, spread)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = texture or "rbxassetid://243660364"
	pe.Color = typeof(color) == "ColorSequence" and color or ColorSequence.new(color or Color3.fromRGB(255, 255, 255))
	pe.Size = typeof(size) == "NumberSequence" and size or NumberSequence.new(size or 1)
	pe.Lifetime = NumberRange.new(lifetime or 1)
	pe.Speed = NumberRange.new(speed or 5)
	pe.Rate = rate or 40
	if spread then
		pe.SpreadAngle = Vector2.new(spread, spread)
	end
	pe.Parent = parent
	return pe
end

